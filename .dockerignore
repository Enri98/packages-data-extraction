# Build hygiene — keep the image small and free of dev-only / secret material.
.venv/
.git/
.gitignore
.claude/
.dockerignore
.env
.env.example

# Tests, fixtures, dev-only data
tests/
notebooks/
samples/
data/
eval_vlm_cache/

# Caches and build artifacts
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
build/
dist/

# Editor / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db

# Docs not needed at runtime
*.md
!README.md
