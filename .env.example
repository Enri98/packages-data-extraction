# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.

# ── Gemini ──────────────────────────────────────────────────────────────────
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Google Sheets ────────────────────────────────────────────────────────────
# The ID from the Sheet URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
GOOGLE_SHEET_ID=your_sheet_id_here

# ── Google Drive ─────────────────────────────────────────────────────────────
# ID of the Drive folder that receives incoming PDFs
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id_here

# ── Service account (local dev only) ─────────────────────────────────────────
# Absolute path to the service account JSON downloaded from GCP console.
# Store OUTSIDE the repo directory. In production, use Secret Manager instead.
GOOGLE_SERVICE_ACCOUNT_JSON=/path/outside/repo/service_account.json

# ── GCP project ──────────────────────────────────────────────────────────────
GCP_PROJECT_ID=your_gcp_project_id_here
CLOUD_RUN_REGION=us-central1

# ── Pipeline tuning ──────────────────────────────────────────────────────────
# Max concurrent PDFs processed in batch mode (semaphore limit)
MAX_CONCURRENT_PDFS=3

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
